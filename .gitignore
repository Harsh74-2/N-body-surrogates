# Local per-real-case-validation working artifacts (regenerable).
# The canonical tracked copies are real_case_validation/report_N*/ and
# real_case_validation/animations/; animations_run/ and report_dump/
# are intermediate render output and never intended to be committed.
real_case_validation/animations_run/
real_case_validation/report_dump/
# Intermediate dump-preds artifacts the runner writes inside each
# preset dir when --dump-preds is set. The PNG plots + summary.json
# inside the same dir ARE tracked; only these raw arrays are not.
# (Regenerated by real_case_validation/_render_dist_anims.py.)
real_case_validation/report_N*/preset_*/preds.npy
real_case_validation/report_N*/preset_*/preds_meta.json
real_case_validation/report_N*/preset_*/book_pos.npy
# Same for the single-step dumps (raw arrays regenerated by re-running
# the runner with --single-step --dump-preds; only ss_summary.json and
# the reports are tracked).
real_case_validation/report_N*/single_step/preset_*/preds.npy
real_case_validation/report_N*/single_step/preset_*/ref_pos.npy
real_case_validation/report_N*/single_step/preset_*/preds_meta.json

# Local run artifacts (model weights are large binaries and are not
# redistributed; all reported numbers are reproducible from the pipeline
# + the listed hyperparameters).
training_runs/
results/N*/

# Notebook + interactive state
.ipynb_checkpoints/
*.py.bak

# Build / packaged bundles
*.zip
*.tar.gz
*.tgz

# Generated documents and drafts (docx/html) are not part of the repo
*.docx
Project_Mathematics_native_math.html

# Self-contained HTML visualizer archived to archive/webartifacts/.
# Ignore at root in case it resurfaces.
/disc_model_comparison.html

# Local log files
*.log
# Per-N rerun.log inside real_case_validation/report_N*/: per-run trace,
# regenerable by re-running the runner with --quick + the same ckpts.
real_case_validation/report_N*/rerun.log

# GitHub Pages site build (output of build_github_pages.py — deploys
# to a separate gh-pages branch via git subtree push).
gh_pages_build/
# Interactive Plotly HTML staging dir (output of
# build_interactive_htmls.py — copied into gh_pages_build/interactive/).
interactive_htmls/

